{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyt-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    // Everything the Worker does not own yet is forwarded here. Removed once
    // the last route moves (CF-32).
    "ORIGIN_URL": "https://api.flyt.africa"
  }
}
