{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyt-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "BackendContainer",
      // The Dockerfile itself, not its directory. Build context is backend/
      // because the image COPYs docker-entrypoint.sh from there.
      "image": "../backend/Dockerfile",
      "image_build_context": "../backend",
      // Provisional. Memory is billed on provisioned resources, not usage,
      // so this starts small and gets sized against a real deploy (CF-08).
      "instance_type": "basic",
      "max_instances": 3
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "BackendContainer" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BackendContainer"] }]
}
