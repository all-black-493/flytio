{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyt-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // No routes here yet. Adding one binds the Worker to production; the DNS
  // and certificate steps in docs/cloudflare-migration.md come first.

  "vars": {
    // NOT api.flyt.africa. Once the Worker serves that hostname, proxying to
    // it loops back into the Worker. origin.* is the direct path to EC2.
    "ORIGIN_URL": "https://origin.flyt.africa"
  }
}
