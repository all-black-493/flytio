{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyt-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Points at Neon's DIRECT endpoint. Hyperdrive pools; stacking it on
      // Neon's PgBouncer would be pooling twice.
      //
      // No localConnectionString here - that would put a database URL in the
      // repo. `wrangler dev` reads
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
      "id": "95658e25decb441087501652e50ca452"
    }
  ],

  "vars": {
    // NOT api.flyt.africa. Once the Worker serves that hostname, proxying to
    // it loops back into the Worker. origin.* is the direct path to EC2.
    "ORIGIN_URL": "https://origin.flyt.africa"
  },
  // Inert until the api.flyt.africa record is proxied - a route never fires on
  // a DNS-only record. Proxying it is the cutover, and it waits on
  // origin.flyt.africa holding a certificate, so the proxy fallback has a
  // target. See CF-33 in docs/cloudflare-migration.md.
  "routes": [{ "pattern": "api.flyt.africa/*", "zone_name": "flyt.africa" }]
}
