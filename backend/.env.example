# Copy to .env and fill in real values. See backend/config.py (Settings)
# for how these are loaded/validated - every var below is read there,
# nowhere else.

# Activates compose.yaml's `local` profile, i.e. the `db` Postgres
# container. Without it `docker compose up` starts no database and
# `docker compose down` leaves the one you started behind, still holding
# the network open. Deployed environments generate their own .env without
# this line, so the server never runs a local Postgres alongside Neon.
COMPOSE_PROFILES=local

# Get RESEND_API_KEY from the Resend dashboard (API Keys). MAIL_DOMAIN
# must be verified there (flyt.africa) - once verified, Resend lets you
# send from any address at it (hello@, noreply@, bookings@ - see
# utils/email.py's named senders), no per-address setup needed.
RESEND_API_KEY=
MAIL_DOMAIN=flyt.africa
# Sender display name shown in recipients' inboxes.
MAIL_FROM_NAME=flyt

ACCESS_TOKEN_EXPIRE_MINUTES=60
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256

# Local: the `db` container from compose.yaml's `local` profile, started
# with `docker compose --profile local up -d db`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Only needed on serverless Postgres (Neon), where DATABASE_URL above is
# the POOLED endpoint (hostname ends `-pooler`) and this is the DIRECT
# one. Alembic and scripts/init_db.py use it, because a transaction-mode
# pooler can't run schema changes. Leave empty for a plain Postgres.
DATABASE_MIGRATION_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

DUFFEL_API_TOKEN=
# Run `python -m backend.scripts.register_duffel_webhook` once to get this.
DUFFEL_WEBHOOK_SECRET=

# Origins allowed to hit the API with credentials (comma-separated, no
# spaces, no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://localhost

# Pesapal (customer payment collection) - sign up for a sandbox merchant
# account at developer.pesapal.com to get these. PESAPAL_ENV selects the
# base URL ("sandbox" -> cybqa.pesapal.com, "live" -> pay.pesapal.com).
# PESAPAL_IPN_ID is produced once per environment by running
# `python -m backend.scripts.register_pesapal_ipn` after the rest of these
# are set.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_IPN_ID=

# Used to build the URLs handed to users and external services:
# FRONTEND_URL for user-facing links (password reset, booking
# confirmation, the Pesapal redirect back into the app, the email logo
# asset); BACKEND_PUBLIC_URL for URLs handed to services that need to
# reach us (Pesapal's IPN webhook, the itinerary PDF link in emails).
# Both must be real public domains in production - Pesapal's servers in
# particular can't reach localhost, so BACKEND_PUBLIC_URL needs
# ngrok/cloudflared for local testing.
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# Air travel concierge - optional. Get an API key from
# platform.openai.com (API Keys). Left blank, the concierge endpoint
# cleanly 503s instead of the app failing to start. CONCIERGE_MODEL is a
# bare OpenAI model name, no "openai:" prefix (see
# external_services/concierge.py for why).
OPENAI_API_KEY=
CONCIERGE_MODEL=gpt-5.2

# Destination photos (popular-destinations cards) - optional. Get an
# Access Key from unsplash.com/oauth/applications (only the Access Key is
# used - see config.py for why the App ID/Secret Key aren't). Left
# blank, cards just render without a photo. Fetched once by
# scripts/backfill_destination_images.py, never live per-request.
UNSPLASH_ACCESS_KEY=

# Auth cookie config - unset/false locally (host-only cookies already span
# ports on localhost). In production, set COOKIE_DOMAIN to the shared
# parent domain (e.g. "flyt.io") so the cookie is visible to both the
# frontend and API subdomains, and COOKIE_SECURE=true since it'll be
# served over HTTPS.
COOKIE_DOMAIN=
COOKIE_SECURE=false
