# Copy to .env.local and fill in real values.

# Base URL of the backend API (see backend/.env.example's FRONTEND_URL/
# BACKEND_PUBLIC_URL for the other side of this). Used in
# src/lib/api/client.ts and for the itinerary PDF download link on the
# booking detail page.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Analytics 4 measurement ID (starts with "G-"). Optional - leave
# unset to disable analytics entirely. When set, GA only actually loads
# once a visitor accepts the cookie consent banner (src/components/
# analytics/google-analytics-gate.tsx) - never before, and never if they
# reject.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
