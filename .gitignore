
.playwright-mcp
.kombai
mprocs.yaml
mprocs.log

.logs


# Terraform working directories. .terraform/ holds downloaded provider
# binaries - the AWS provider alone is 675MB, which GitHub rejects outright
# (100MB limit). It is a local cache rebuilt by `terraform init`, never
# source.
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.vercel
# Added by `vercel pull`, which writes .env.local from the project's
# environment. Kept, but with the example files exempted: the pattern matches
# a basename at any depth, so it would silently swallow a new
# backend/.env.example - which the README tells people to copy - while the
# existing one survives only because it is already tracked.
.env*
!.env.example
!*.env.example
!.env.sample
!*.env.sample
